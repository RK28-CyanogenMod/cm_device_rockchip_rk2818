#
# system.prop for rk2818
#
dalvik.vm.dexopt-flags=m=y
# 200 MB of RAM: keep per-app heaps small instead of the tablet defaults
# (heapgrowthlimit 48m / heapsize 256m from frameworks tablet-dalvik-heap.mk).
dalvik.vm.heapstartsize=4m
dalvik.vm.heapgrowthlimit=32m
dalvik.vm.heapsize=48m
media.stagefright.enable-record=true
persist.sys.use_dithering=0
persist.sys.use_16bpp_alpha=1
qemu.sf.lcd_density=120
ro.sf.lcd_density=120
ro.additionalmounts=/mnt/sdcard;/mnt/usb
wifi.interface=wlan0
wifi.supplicant_scan_interval=45

accelerometer.invert_x=1
#accelerometer.invert_y=1
#accelerometer.invert_z=1
#accelerometer.flip_xy=1

# Keep StrictMode and SurfaceFlinger debug overlays off in normal use.
persist.sys.strictmode.visual=0
debug.sf.showupdates=0

# RKTSCalibration: enable calibration and require a successful result.
ro.secure.tscalibration=1
app.tscalibration.force=1

# ARMv5 software rendering / no GPU hardware composer.
ro.config.disable_hw_accel=true
debug.sf.hw=0
debug.sf.no_hw_vsync=1

# Keep the combined tablet bar on the 800x480 screen at 120 dpi.
ro.rk28.tablet_ui=true

# PixelFlinger has no FBO screenshot surface for the rotation animation.
ro.rk28.no_rotation_anim=true

# Stock 2.6.25 kernel has no netfilter firewall tables.
ro.rk28.no_iptables=1

# Skip both CRT animators and GL capture on the stock RK2818 display.
ro.rk28.disable_crt=1

# init.rc starts the standalone Jelly Bean compositor. Do not start a second
# SurfaceFlinger inside system_server after every zygote restart.
system_init.startsurfaceflinger=0

# The TF card has one MediaStore identity, even with the legacy nested alias.
testing.mediascanner.skiplist=/mnt/nand/external_sd/
ro.rk28.nested_sd_path=/mnt/nand/external_sd

