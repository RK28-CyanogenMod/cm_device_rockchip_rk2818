#
# system.prop for rk2818
#
dalvik.vm.dexopt-flags=m=y
# 200 MB of RAM: keep per-app heaps small instead of the tablet defaults
# (heapgrowthlimit 48m / heapsize 256m from frameworks tablet-dalvik-heap.mk).
dalvik.vm.heapstartsize=4m
dalvik.vm.heapgrowthlimit=32m
dalvik.vm.heapsize=48m
media.stagefright.enable-record=true
persist.sys.use_dithering=0
persist.sys.use_16bpp_alpha=1
qemu.sf.lcd_density=120
ro.sf.lcd_density=120
ro.additionalmounts=/mnt/nand;/mnt/usb
ro.vold.switchablepair=/mnt/sdcard,/mnt/nand
wifi.interface=wlan0
wifi.supplicant_scan_interval=45

accelerometer.invert_x=1
#accelerometer.invert_y=1
#accelerometer.invert_z=1
#accelerometer.flip_xy=1

# Keep StrictMode and SurfaceFlinger debug overlays off in normal use.
persist.sys.strictmode.visual=0
debug.sf.showupdates=0

# RKTSCalibration: enable calibration and require a successful result.
ro.secure.tscalibration=1
app.tscalibration.force=1
