<?xml version="1.0" encoding="utf-8"?>
<!-- RK2818 tablet status icons; preserve layout IDs used by SignalClusterView. -->
<com.android.systemui.statusbar.SignalClusterView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_height="wrap_content" android:layout_width="wrap_content" android:orientation="horizontal">
    <FrameLayout android:id="@+id/wifi_combo" android:layout_height="32dp" android:layout_width="36dp" android:layout_marginRight="2dp">
        <ImageView android:id="@+id/wifi_signal" android:layout_height="32dp" android:layout_width="36dp" android:layout_alignParentRight="true" android:layout_centerVertical="true" android:scaleType="fitCenter" />
        <ImageView android:id="@+id/wifi_inout" android:layout_height="12dp" android:layout_width="12dp" android:layout_gravity="center|bottom" android:scaleType="fitCenter" />
    </FrameLayout>
    <View android:layout_height="6dp" android:layout_width="6dp" android:visibility="gone" android:id="@+id/spacer" />
    
    <FrameLayout android:layout_height="wrap_content" android:layout_width="wrap_content">
        <View android:layout_height="6dp" android:layout_width="6dp" android:visibility="invisible" />
        <FrameLayout android:id="@+id/mobile_combo" android:layout_width="36dp" android:layout_height="32dp" android:layout_marginRight="2dp">
            <ImageView android:id="@+id/mobile_signal" android:layout_height="32dp" android:layout_width="36dp" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/mobile_type" android:layout_height="12dp" android:layout_width="12dp" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/mobile_inout" android:layout_height="12dp" android:layout_width="12dp" android:layout_gravity="right|bottom" android:scaleType="fitCenter" />
        </FrameLayout>
    </FrameLayout>
    <ImageView android:id="@+id/airplane" android:layout_height="32dp" android:layout_width="36dp" android:scaleType="fitCenter" />
    <ImageView android:id="@+id/ethernet" android:layout_height="32dp" android:layout_width="36dp" android:scaleType="fitCenter" />
</com.android.systemui.statusbar.SignalClusterView>
